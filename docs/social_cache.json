[{"platform": "X / Twitter", "handle": "@GavinNewsom", "url": "https://x.com/GavinNewsom/status/1933235335166898346", "icon": "<svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z\"/></svg>", "text": "If they can handcuff a U.S. Senator for asking a question, imagine what they will do to you.", "time": "Jun 12, 2025 - 06:49 PM", "timestamp": "Thu Jun 12 18:49:56 +0000 2025", "foot": "@GavinNewsom"}, {"platform": "X / Twitter", "handle": "@GavinNewsom", "url": "https://x.com/GavinNewsom/status/1932486104583975413", "icon": "<svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z\"/></svg>", "text": "There was no call. Not even a voicemail.\n\nAmericans should be alarmed that a President deploying Marines onto our streets doesn\u2019t even know who he\u2019s talking to.", "time": "Jun 10, 2025 - 05:12 PM", "timestamp": "Tue Jun 10 17:12:45 +0000 2025", "foot": "@GavinNewsom"}, {"platform": "X / Twitter", "handle": "@GavinNewsom", "url": "https://x.com/GavinNewsom/status/1958276563650461707", "icon": "<svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z\"/></svg>", "text": "The company that already went bankrupt and closed every store across the country two years ago? Ok.", "time": "Aug 20, 2025 - 09:14 PM", "timestamp": "Wed Aug 20 21:14:50 +0000 2025", "foot": "@GavinNewsom"}, {"platform": "X / Twitter", "handle": "@GavinNewsom", "url": "https://x.com/GavinNewsom/status/1957289966771609737", "icon": "<svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z\"/></svg>", "text": "I miss that scarf.", "time": "Aug 18, 2025 - 03:54 AM", "timestamp": "Mon Aug 18 03:54:27 +0000 2025", "foot": "@GavinNewsom"}, {"platform": "X / Twitter", "handle": "@GavinNewsom", "url": "https://x.com/GavinNewsom/status/1965851236630192261", "icon": "<svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z\"/></svg>", "text": "The attack on Charlie Kirk is disgusting, vile, and reprehensible. In the United States of America, we must reject political violence in EVERY form.", "time": "Sep 10, 2025 - 06:53 PM", "timestamp": "Wed Sep 10 18:53:53 +0000 2025", "foot": "@GavinNewsom"}, {"platform": "X / Twitter", "handle": "@GavinNewsom", "url": "https://x.com/GavinNewsom/status/1970532570132816060", "icon": "<svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z\"/></svg>", "text": "Trump\u2019s teleprompter broke.\n\nHe told every other nation they are going to hell.\n\nHe bragged about violating international law.\n\nHe blamed climate change on immigrants.\n\nHe complained about the wind not blowing enough.\n\nAnd made a plug for his campaign hats.\n\nWhat a disgrace.", "time": "Sep 23, 2025 - 04:55 PM", "timestamp": "Tue Sep 23 16:55:50 +0000 2025", "foot": "@GavinNewsom"}, {"platform": "X / Twitter", "handle": "@GavinNewsom", "url": "https://x.com/GavinNewsom/status/1932157825117208729", "icon": "<svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z\"/></svg>", "text": "You sent your troops here without fuel, food, water or a place to sleep.\n\nHere they are \u2014 being forced to sleep on the floor, piled on top of one another. \n\nIf anyone is treating our troops disrespectfully, it is you @realDonaldTrump.", "time": "Jun 09, 2025 - 07:28 PM", "timestamp": "Mon Jun 09 19:28:17 +0000 2025", "foot": "@GavinNewsom"}, {"platform": "X / Twitter", "handle": "@GavinNewsom", "url": "https://x.com/GavinNewsom/status/1932172840469758198", "icon": "<svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z\"/></svg>", "text": "Like this?", "time": "Jun 09, 2025 - 08:27 PM", "timestamp": "Mon Jun 09 20:27:57 +0000 2025", "foot": "@GavinNewsom"}, {"platform": "X / Twitter", "handle": "@GavinNewsom", "url": "https://x.com/GavinNewsom/status/1985987357200589037", "icon": "<svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z\"/></svg>", "text": "We just did.", "time": "Nov 05, 2025 - 08:27 AM", "timestamp": "Wed Nov 05 08:27:38 +0000 2025", "foot": "@GavinNewsom"}]